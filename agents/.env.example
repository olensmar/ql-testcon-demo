# The Testkube MCP server hosted by the control plane (nothing runs locally).
# Copy this file to agents/.env and paste a Testkube API token with access to the environment
# (Testkube dashboard: organization settings, API tokens).
TK_MCP_URL=https://api.testkube.dev/organizations/tkcorg_9deb42dda2197657/environments/tkcenv_a0058057f924cc8d/mcp
TK_ACCESS_TOKEN=

# --- Alternative: drive Testkube through the CLI instead of the hosted MCP server -------------
# Works with Testkube Open Source too (which has no MCP server). The agents see the same tools.
# TESTKUBE_BACKEND=cli
# Optional, to point the CLI at another Testkube without touching your default CLI context:
# TK_CLI_HOME=/Users/you/.ql-testcon-oss/home            # HOME for the CLI (its ~/.testkube config)
# TK_CLI_KUBECONFIG=/Users/you/.ql-testcon-oss/kubeconfig  # cluster running Testkube Open Source
# TK_CLI_NAMESPACE=testkube                               # where Testkube runs (pre-demo check)
# TK_CLI_ARGS=--namespace testkube                        # extra global flags for every CLI call
