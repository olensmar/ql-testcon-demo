{
  "info": {
    "name": "Plushie Shop – Cart API",
    "description": "Catalog and cart endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "List products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"lists 5 products\", () => pm.expect(pm.response.json()).to.have.length(5));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "Create cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"cartId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart"
          ]
        }
      }
    },
    {
      "name": "Add 2 gophers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"cart has 2 gophers\", () => pm.expect(pm.response.json().items[0].quantity).to.eql(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{cartId}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "{{cartId}}",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":\"gopher\",\"quantity\":2}"
        }
      }
    },
    {
      "name": "Add one more gopher",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"quantity is merged\", () => { const items = pm.response.json().items; pm.expect(items).to.have.length(1); pm.expect(items[0].quantity).to.eql(3); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{cartId}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "{{cartId}}",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":\"gopher\"}"
        }
      }
    },
    {
      "name": "Add unknown product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{cartId}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "{{cartId}}",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":\"does-not-exist\"}"
        }
      }
    },
    {
      "name": "Get cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns the cart\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"cartId\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{cartId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "{{cartId}}"
          ]
        }
      }
    },
    {
      "name": "Get unknown cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/nope",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "nope"
          ]
        }
      }
    }
  ]
}
