{
  "info": {
    "name": "Plushie Shop \u2013 Checkout API",
    "description": "Checkout totals: subtotal, shipping and total",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Create cart under $50",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"smallCart\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart"
          ]
        }
      }
    },
    {
      "name": "Add gopher ($12)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{smallCart}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "{{smallCart}}",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":\"gopher\"}"
        }
      }
    },
    {
      "name": "Add octopus ($18)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{smallCart}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "{{smallCart}}",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":\"octopus\"}"
        }
      }
    },
    {
      "name": "Checkout under $50 pays shipping",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json();",
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"subtotal is 30.00\", () => pm.expect(order.subtotal).to.eql(30));",
              "pm.test(\"shipping is 5.00\", () => pm.expect(order.shipping).to.eql(5));",
              "pm.test(\"total is 35.00\", () => pm.expect(order.total).to.eql(35));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "checkout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cartId\":\"{{smallCart}}\"}"
        }
      }
    },
    {
      "name": "Checkout under $50 with SAVE10",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json();",
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"discount is 10% of the 30.00 subtotal\", () => pm.expect(order.discount).to.eql(3));",
              "pm.test(\"shipping is still 5.00\", () => pm.expect(order.shipping).to.eql(5));",
              "pm.test(\"total is 32.00\", () => pm.expect(order.total).to.eql(32));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "checkout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cartId\": \"{{smallCart}}\", \"discountCode\": \"SAVE10\"}"
        }
      }
    },
    {
      "name": "Checkout with an invalid discount code is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"explains the error\", () => pm.expect(pm.response.json().error).to.include(\"invalid discount code\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "checkout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cartId\": \"{{smallCart}}\", \"discountCode\": \"FREESTUFF\"}"
        }
      }
    },
    {
      "name": "Create cart over $50",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"bigCart\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart"
          ]
        }
      }
    },
    {
      "name": "Add bear ($45)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{bigCart}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "{{bigCart}}",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":\"teddy-bear\"}"
        }
      }
    },
    {
      "name": "Add penguin ($6)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart/{{bigCart}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart",
            "{{bigCart}}",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":\"mini-penguin\"}"
        }
      }
    },
    {
      "name": "Checkout over $50 ships free",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json();",
              "pm.test(\"shipping is free\", () => pm.expect(order.shipping).to.eql(0));",
              "pm.test(\"total is 51.00\", () => pm.expect(order.total).to.eql(51));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "checkout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cartId\":\"{{bigCart}}\"}"
        }
      }
    },
    {
      "name": "Create empty cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emptyCart\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart"
          ]
        }
      }
    },
    {
      "name": "Checkout empty cart is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"returns 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "checkout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cartId\":\"{{emptyCart}}\"}"
        }
      }
    }
  ]
}
